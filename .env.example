# ==== KM Car Deals AI Agent - Environment Configuration ====
# Copy to .env and fill in real values. Never commit .env to version control.

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/km_car_deals

# --- Auth ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- WhatsApp Business API (official, never hard-code) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
# Approved outbound template name (used when a template is required)
WHATSAPP_TEMPLATE=

# --- Meta WhatsApp Commerce Catalog ---
META_WA_CATALOG_ID=
META_WA_BUSINESS_ID=

# --- Instagram / Meta Graph ---
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- AI providers (feature-gated) ---
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
AI_LLM_ENABLED=false
AI_OCR_ENABLED=false
AI_VISION_ENABLED=false
AI_IMAGE_ENABLED=false

# --- Follow-up / messaging policy ---
SEND_MESSAGES_AUTOMATICALLY=false
MAX_MESSAGES_PER_DAY=3
MINIMUM_FOLLOWUP_INTERVAL_HOURS=24
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=20:00

# --- Public API access ---
PUBLIC_API_REQUIRES_KEY=false
PUBLIC_API_KEY=

# --- CORS ---
CORS_ORIGINS=*
